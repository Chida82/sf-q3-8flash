#!/bin/sh
# sfctl: run StarForge models as on-demand launchd services.
#
# The same script ships in every child; only sfctl/sf-<model>.conf differs.
# Each service runs from its own serve worktree, ~/.sf/<model>/serve, detached
# at the child's local main. Nothing starts at login or restarts on exit.
# Agents: read sfctl/README.md before running install, update or uninstall.
set -eu

LA="$HOME/Library/LaunchAgents"
LOGS="$HOME/Library/Logs/sf"
CMD_LINK="$HOME/.local/bin/sfctl"
DOMAIN="gui/$(id -u)"
FANBOOST=/usr/local/bin/fanboost
SF_VARIANTS= MODEL= VARIANT=

# The directory holding this script, through the ~/.local/bin link.
self=$0
while [ -L "$self" ]; do
    t=$(readlink "$self")
    case $t in
        /*) self=$t ;;
        *) self=$(dirname "$self")/$t ;;
    esac
done
SFDIR=$(cd "$(dirname "$self")" && pwd -P)

usage() {
    cat >&2 <<'EOF'
usage: sfctl <command> [<service>]

  install [<model>]     run from a child checkout: serve worktree at main, build,
                        model links, launchd agent, ~/.local/bin/sfctl
  update <service>      sync serve to local main and rebuild; a running service
                        is restarted, a stopped one stays stopped
  start <service>       start the service (it never starts on its own); a model
                        with variants needs <model>-<variant>
  stop <service>        stop the service
  restart <service>     stop, then start; <model>-<variant> switches variant,
                        <model> restarts the last one started
  status [<service>]    state, variant, pid, port and serve commit; every
                        installed model when no service is named
  logs <service> [N]    last N lines of the service log (default 80)
  follow <service>      follow the service log
  plist <service>       print the launchd agent definition, write nothing
  uninstall <service>   remove the agent and serve; keep KV, logs and models

<model> is the child's name without "sf-"; its service is sfctl/sf-<model>.conf.
A config that lists SF_VARIANTS (one set of weights each) also names the
service <model>-<variant>; commands other than start accept either name.
EOF
    exit 2
}

die() {
    echo "sfctl: $*" >&2
    exit 1
}

label() { echo "com.starforge.sf-$1"; }
target() { echo "$DOMAIN/$(label "$1")"; }
plist_path() { echo "$LA/$(label "$1").plist"; }
home_dir() { echo "$HOME/.sf/$1"; }
serve_dir() { echo "$HOME/.sf/$1/serve"; }
svc() { echo "$1${2:+-$2}"; }

installed_models() {
    for f in "$LA"/com.starforge.sf-*.plist; do
        [ -e "$f" ] || continue
        n=${f##*/com.starforge.sf-}
        echo "${n%.plist}"
    done
}

running_models() {
    for m in $(installed_models); do
        [ -n "$(pid "$m")" ] && echo "$m"
    done
    return 0
}

pid() {
    launchctl print "$(target "$1")" 2>/dev/null |
        awk '$1 == "pid" && $2 == "=" { print $3; exit }'
}

loaded() { launchctl print "$(target "$1")" >/dev/null 2>&1; }

need_model() {
    # $1 command, $2 model (may be empty)
    if [ -z "$2" ]; then
        running=$(running_models | tr '\n' ' ')
        echo "sfctl: $1 needs a model${running:+ (running: ${running% })}" >&2
        usage
    fi
}

need_installed() {
    [ -e "$(plist_path "$1")" ] ||
        die "$1 is not installed (run sfctl install from the sf-$1 checkout)"
}

# Variant helpers; load_conf first.
is_variant() {
    [ -n "$1" ] || return 1
    case " $SF_VARIANTS " in *" $1 "*) return 0 ;; esac
    return 1
}
variant_model() { eval "echo \"\${SF_MODEL_$1:-}\""; }
# A variant's own arguments, appended to SF_ARGS; empty when the config sets none.
variant_args() { [ -n "${1:-}" ] || return 0; eval "echo \"\${SF_ARGS_$1:-}\""; }
variant_names() {
    n=
    for x in $SF_VARIANTS; do n="$n $1-$x"; done
    echo "${n# }"
}
need_variant() {
    echo "sfctl: $1 $2 needs a variant: $(variant_names "$2")" >&2
    usage
}
# The variant last started, as recorded by start; empty when none is.
recorded_variant() { cat "$(home_dir "$1")/variant" 2>/dev/null || true; }
# The variant an agent is written for when none is named: the recorded one,
# else the first listed. Empty for a config without variants.
current_variant() {
    r=$(recorded_variant "$1")
    if is_variant "$r"; then echo "$r"; return; fi
    # shellcheck disable=SC2086
    set -- $SF_VARIANTS
    echo "${1:-}"
}

# Sources sf-<model>.conf from <dir>/sfctl.
load_conf() {
    conf="$2/sfctl/sf-$1.conf"
    [ -f "$conf" ] || die "no config for $1: $conf"
    # cv, not v: callers keep their variant in v across this call.
    for cv in $SF_VARIANTS; do unset "SF_MODEL_$cv" "SF_ARGS_$cv"; done
    SF_PORT= SF_SERVER= SF_COMPONENTS= SF_ARGS= SF_VARIANTS=
    . "$conf"
    [ -n "$SF_PORT" ] && [ -n "$SF_SERVER" ] && [ -n "$SF_ARGS" ] ||
        die "$conf must set SF_PORT, SF_SERVER and SF_ARGS"
    case "$SF_ARGS" in
        *[\<\>\&]*) die "$conf: SF_ARGS must not contain <, > or &" ;;
        *@VARIANT@*) [ -n "$SF_VARIANTS" ] || die "$conf: @VARIANT@ needs SF_VARIANTS" ;;
    esac
    for cv in $SF_VARIANTS; do
        case $cv in
            *[!A-Za-z0-9_]*) die "$conf: variant names use letters, digits and _ only: $cv" ;;
        esac
        cs=$(variant_model "$cv")
        case $cs in *[\<\>\&\ ]*) cs= ;; esac
        case $cs in
            ?*:?*) ;;
            *) die "$conf: SF_MODEL_$cv must be component:path, without spaces, <, > or &" ;;
        esac
        case $(variant_args "$cv") in
            *[\<\>\&]*) die "$conf: SF_ARGS_$cv must not contain <, > or &" ;;
        esac
    done
}

# The config of an installed model comes from serve; before install, from
# this script's own checkout.
conf_dir() {
    if [ -d "$(serve_dir "$1")" ]; then serve_dir "$1"; else dirname "$SFDIR"; fi
}

has_conf() { [ -f "$(conf_dir "$1")/sfctl/sf-$1.conf" ]; }

# Splits a service name into MODEL and VARIANT and loads that model's config
# when there is one: <model>, or <model>-<variant> with <variant> in the
# config's SF_VARIANTS. Model names may contain "-", variant names may not.
resolve() {
    MODEL=$1 VARIANT=
    if has_conf "$1"; then
        load_conf "$1" "$(conf_dir "$1")"
        return
    fi
    case $1 in *-*) ;; *) return 0 ;; esac
    has_conf "${1%-*}" || return 0
    MODEL=${1%-*}
    load_conf "$MODEL" "$(conf_dir "$MODEL")"
    is_variant "${1##*-}" ||
        die "$MODEL has no variant ${1##*-}${SF_VARIANTS:+; its services: $(variant_names "$MODEL")}"
    VARIANT=${1##*-}
}

plist_text() {
    m=$1 v=${2:-}
    serve=$(serve_dir "$m")
    load_conf "$m" "$(conf_dir "$m")"
    cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by sfctl from sfctl/sf-$m.conf${v:+ for $m-$v}: edit that file and run sfctl update $m. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$(label "$m")</string>
  <key>ProgramArguments</key>
  <array>
    <string>$serve/$SF_SERVER</string>
    <string>--port</string>
    <string>$SF_PORT</string>
EOF
    if [ -n "$v" ]; then
        spec=$(variant_model "$v")
        echo "    <string>-m</string>"
        echo "    <string>${spec#*:}</string>"
    fi
    for a in $SF_ARGS $(variant_args "$v"); do
        case $a in
            *@VARIANT@*) a="${a%%@VARIANT@*}$v${a#*@VARIANT@}" ;;
        esac
        case $a in
            *@HOME@*) a="$(home_dir "$m")${a#*@HOME@}" ;;
        esac
        echo "    <string>$a</string>"
    done
    cat <<EOF
  </array>
  <key>WorkingDirectory</key>
  <string>$serve</string>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>$LOGS/$m.out.log</string>
  <key>StandardErrorPath</key>
  <string>$LOGS/$m.err.log</string>
</dict>
</plist>
EOF
}

# $1 model, $2 variant (empty without variants). The server creates its KV dir.
write_plist() {
    mkdir -p "$LA" "$LOGS" "$(home_dir "$1")"
    plist_text "$1" "${2:-}" >"$(plist_path "$1").tmp"
    plutil -lint -s "$(plist_path "$1").tmp" || die "generated agent for $1 is not a valid plist"
    mv "$(plist_path "$1").tmp" "$(plist_path "$1")"
}

# Links each component, and each variant's model, whose path is missing in
# serve (load_conf first).
link_components() {
    serve=$1
    for c in $SF_COMPONENTS $(for lv in $SF_VARIANTS; do variant_model "$lv"; done); do
        [ -e "$serve/${c#*:}" ] && continue
        (cd "$serve" && ./download.sh "${c%%:*}") || die "./download.sh ${c%%:*} failed in $serve"
    done
}

# start never links or downloads: install and update do (load_conf first).
model_check() {
    [ -n "$2" ] || return 0
    spec=$(variant_model "$2")
    serve=$(serve_dir "$1")
    [ ! -e "$serve/${spec#*:}" ] || return 0
    die "$1-$2 needs $serve/${spec#*:}, which is missing; link it with: sfctl update $1"
}

build() {
    make -C "$1" "$SF_SERVER" || die "build failed in $1 at $(git -C "$1" rev-parse --short HEAD); the service is not started"
}

wait_exit() {
    i=0
    while kill -0 "$1" 2>/dev/null; do
        i=$((i + 1))
        [ "$i" -le 120 ] || die "pid $1 still running after 120 s"
        sleep 1
    done
}

# One engine at a time: another sfctl service, or any process holding an
# engine instance lock (manual runs, upstream ds4). The engine's own flock
# still decides a race between two starts.
exclusion_check() {
    for o in $(running_models); do
        [ "$o" = "$1" ] && continue
        die "$o is running (pid $(pid "$o")); stop it first: sfctl stop $o"
    done
    holders=$(lsof -t /tmp/ds4.lock /tmp/sf-*.lock 2>/dev/null | sort -u | tr '\n' ' ')
    if [ -n "$holders" ]; then
        for p in $holders; do
            echo "sfctl: pid $p ($(ps -o comm= -p "$p" 2>/dev/null)) holds an engine instance lock" >&2
        done
        die "stop that engine before starting $1"
    fi
}

boost_check() {
    case " $SF_ARGS $(variant_args "${2:-}") " in
        *" --boost"*)
            "$FANBOOST" check || die "$1 asks for boost, and fanboost check failed: install or restart it with ./fanboost/install.sh (see fanboost/README.md)"
            ;;
    esac
}

# $1 model, $2 variant (required when the config lists variants).
cmd_start() {
    need_installed "$1"
    load_conf "$1" "$(serve_dir "$1")"
    p=$(pid "$1")
    if [ -n "$p" ]; then
        cur=$(recorded_variant "$1")
        if [ -n "$SF_VARIANTS" ] && [ "$cur" != "$2" ]; then
            die "$1 is running${cur:+ $1-$cur} (pid $p); to switch run: sfctl restart $1-$2"
        fi
        echo "$(svc "$1" "$2") already running (pid $p)"
        return
    fi
    model_check "$1" "$2"
    exclusion_check "$1"
    boost_check "$1" "$2"
    if [ -n "$2" ]; then
        # The agent carries the variant's arguments: reload it with this one.
        ! loaded "$1" || launchctl bootout "$(target "$1")"
        write_plist "$1" "$2"
        echo "$2" >"$(home_dir "$1")/variant"
    fi
    mkdir -p "$LOGS"
    loaded "$1" || launchctl bootstrap "$DOMAIN" "$(plist_path "$1")"
    launchctl kickstart -k "$(target "$1")"
    echo "$(svc "$1" "$2") starting on 127.0.0.1:$SF_PORT; watch the load with: sfctl follow $1"
}

cmd_stop() {
    need_installed "$1"
    p=$(pid "$1")
    if [ -z "$p" ]; then
        echo "$1 is not running"
        return
    fi
    launchctl kill SIGTERM "$(target "$1")"
    wait_exit "$p"
    echo "$1 stopped"
}

status_line() {
    m=$1
    serve=$(serve_dir "$m")
    p=$(pid "$m")
    state="stopped"
    [ -n "$p" ] && state="running pid $p"
    if [ ! -d "$serve" ]; then
        echo "$m $state, serve missing ($serve)"
        return
    fi
    info=$( (load_conf "$m" "$serve" && echo "$SF_PORT $SF_VARIANTS") 2>/dev/null || echo "?")
    port=${info%% *}
    r=
    case $info in *" "?*) r=$(recorded_variant "$m") ;; esac
    if [ -n "$r" ] && [ -n "$p" ]; then
        state="running $r pid $p"
    elif [ -n "$r" ]; then
        state="stopped (last $r)"
    fi
    cur=$(git -C "$serve" rev-parse --short HEAD)
    main=$(git -C "$serve" rev-parse --short main)
    if [ "$cur" = "$main" ]; then
        sync="serve $cur = main"
    elif git -C "$serve" merge-base --is-ancestor HEAD main; then
        sync="serve $cur behind main $main (sfctl update $m)"
    else
        sync="serve $cur differs from main $main"
    fi
    echo "$m $state port $port, $sync"
}

cmd_status() {
    if [ -n "${1:-}" ]; then
        need_installed "$1"
        status_line "$1"
        return
    fi
    models=$(installed_models)
    [ -n "$models" ] || {
        echo "no sfctl service installed"
        return
    }
    for m in $models; do status_line "$m"; done
}

cmd_install() {
    root=$(git -C "$SFDIR" rev-parse --show-toplevel)
    m=${1:-}
    if [ -z "$m" ]; then
        set -- "$SFDIR"/sf-*.conf
        [ $# -eq 1 ] && [ -e "$1" ] || die "install needs a model: no single sfctl/sf-*.conf in $SFDIR"
        m=${1##*/sf-}
        m=${m%.conf}
    fi
    serve=$(serve_dir "$m")
    [ ! -e "$serve" ] || die "$serve exists; to sync it with main run: sfctl update $m"
    git -C "$root" cat-file -e "main:sfctl/sf-$m.conf" 2>/dev/null ||
        die "main has no sfctl/sf-$m.conf: merge the change into main first"
    mkdir -p "$(home_dir "$m")"
    git -C "$root" worktree add --detach "$serve" main
    load_conf "$m" "$serve"
    build "$serve"
    link_components "$serve"
    v=$(current_variant "$m")
    write_plist "$m" "$v"
    mkdir -p "$(dirname "$CMD_LINK")"
    if [ ! -e "$CMD_LINK" ] && [ ! -L "$CMD_LINK" ]; then
        ln -s "$serve/sfctl/sfctl" "$CMD_LINK"
    elif [ -L "$CMD_LINK" ]; then
        case $(readlink "$CMD_LINK") in
            "$HOME"/.sf/*/serve/*) ln -sfn "$serve/sfctl/sfctl" "$CMD_LINK" ;;
            *) echo "sfctl: $CMD_LINK points elsewhere; left alone" >&2 ;;
        esac
    else
        echo "sfctl: $CMD_LINK is not a link; left alone" >&2
    fi
    echo "$m installed at $(git -C "$serve" rev-parse --short HEAD); start it with: sfctl start $(svc "$m" "$v")"
}

cmd_update() {
    m=$1
    need_installed "$m"
    serve=$(serve_dir "$m")
    [ -d "$serve" ] || die "$serve is missing; uninstall and install $m again"
    dirty=$(git -C "$serve" status --porcelain)
    [ -z "$dirty" ] || die "serve has local modifications, nothing stopped:
$dirty"
    old=$(git -C "$serve" rev-parse --short HEAD)
    was=$(pid "$m")
    if [ -n "$was" ]; then
        launchctl kill SIGTERM "$(target "$m")"
        wait_exit "$was"
        echo "$m stopped for the update"
    fi
    git -C "$serve" checkout --quiet --detach main
    # The rest is main's to do: this script may be older than main's.
    exec "$serve/sfctl/sfctl" _update-finish "$m" "$old" "$was"
}

# Internal: the second half of update, run by the script serve just checked
# out. Keep the name and arguments stable: the previous script execs it.
cmd_update_finish() {
    m=$1 old=$2 was=$3
    serve=$(serve_dir "$m")
    load_conf "$m" "$serve"
    build "$serve"
    link_components "$serve"
    # A running agent written before variants existed ran the first variant.
    uv=$(current_variant "$m")
    ! loaded "$m" || launchctl bootout "$(target "$m")"
    write_plist "$m" "$uv"
    [ -z "$was" ] || cmd_start "$m" "$uv"
    new=$(git -C "$serve" rev-parse --short HEAD)
    echo "$m serve $old..$new"
    git -C "$serve" log --oneline "$old..$new"
}

cmd_uninstall() {
    m=$1
    need_installed "$m"
    serve=$(serve_dir "$m")
    [ -z "$(pid "$m")" ] || cmd_stop "$m"
    ! loaded "$m" || launchctl bootout "$(target "$m")"
    rm -f "$(plist_path "$m")"
    if [ -d "$serve" ]; then
        git -C "$serve" worktree remove "$serve" ||
            die "git refused to remove $serve (local modifications?); the agent is already gone"
    fi
    if [ -L "$CMD_LINK" ]; then
        case $(readlink "$CMD_LINK") in
            "$serve"/*)
                rm -f "$CMD_LINK"
                for o in $(installed_models); do
                    ln -s "$(serve_dir "$o")/sfctl/sfctl" "$CMD_LINK"
                    break
                done
                ;;
        esac
    fi
    echo "$m uninstalled; kept $(home_dir "$m") (KV, history), $LOGS and the model cache"
}

[ $# -ge 1 ] || usage
cmd=$1
shift
name=${1:-}
case $cmd in
    install) cmd_install "$name" ;;
    _update-finish)
        [ $# -eq 3 ] || usage
        cmd_update_finish "$@"
        ;;
    status)
        [ -z "$name" ] || resolve "$name"
        cmd_status "$MODEL"
        ;;
    update | start | stop | restart | logs | follow | plist | uninstall)
        need_model "$cmd" "$name"
        resolve "$name"
        model=$MODEL
        v=$VARIANT
        case $cmd in
            start | restart)
                if [ -n "$SF_VARIANTS" ] && [ -z "$v" ]; then
                    [ "$cmd" = start ] || v=$(recorded_variant "$model")
                    is_variant "$v" || need_variant "$cmd" "$model"
                fi
                ;;
        esac
        case $cmd in
            update) cmd_update "$model" ;;
            start) cmd_start "$model" "$v" ;;
            stop) cmd_stop "$model" ;;
            restart)
                # Refuse a start that cannot succeed before stopping anything.
                need_installed "$model"
                load_conf "$model" "$(serve_dir "$model")"
                model_check "$model" "$v"
                cmd_stop "$model"
                cmd_start "$model" "$v"
                ;;
            logs)
                need_installed "$model"
                tail -n "${2:-80}" "$LOGS/$model.out.log" "$LOGS/$model.err.log"
                ;;
            follow)
                need_installed "$model"
                tail -F "$LOGS/$model.out.log" "$LOGS/$model.err.log"
                ;;
            plist)
                has_conf "$model" ||
                    die "$model is not installed and $SFDIR has no sf-$model.conf"
                [ -n "$v" ] || v=$(current_variant "$model")
                plist_text "$model" "$v"
                ;;
            uninstall) cmd_uninstall "$model" ;;
        esac
        ;;
    -h | --help | help) usage ;;
    *)
        echo "sfctl: unknown command: $cmd" >&2
        usage
        ;;
esac
